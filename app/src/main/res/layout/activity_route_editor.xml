<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/selected_location" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_top_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/route_editor"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/generateRouteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/random_route_generate"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/brand"
            android:tooltipText="@string/random_route_generate" />

        <ImageButton
            android:id="@+id/scanGpxButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_gpx"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/brand"
            android:tooltipText="@string/scan_gpx" />

        <ImageButton
            android:id="@+id/savedRoutesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/saved_routes"
            android:padding="12dp"
            android:src="@drawable/ic_route" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mapPin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/selected_location"
        android:elevation="4dp"
        android:src="@drawable/ic_map_pin"
        android:translationY="-28dp" />

    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_zoom_group"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoomInButton"
            style="@style/Widget.GpsUpdater.Button.Zoom"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/zoom_in"
            android:text="+" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoomOutButton"
            style="@style/Widget.GpsUpdater.Button.Zoom"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/zoom_out"
            android:text="−" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/myLocationButton"
        style="@style/Widget.GpsUpdater.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="318dp"
        android:contentDescription="@string/center_on_device"
        android:elevation="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="18dp"
        android:text="@string/my_location_label"
        android:textColor="@color/brand"
        android:tooltipText="@string/center_on_device"
        app:backgroundTint="@color/surface"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_my_location"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/brand" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lockButton"
        style="@style/Widget.GpsUpdater.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="384dp"
        android:elevation="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="18dp"
        android:text="@string/lock_here"
        android:textColor="@color/brand"
        app:backgroundTint="@color/surface"
        app:cornerRadius="26dp" />

    <TextView
        android:id="@+id/attributionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="318dp"
        android:background="@drawable/bg_top_bar"
        android:paddingHorizontal="7dp"
        android:paddingVertical="4dp"
        android:text="@string/map_attribution"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
            android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/panelHandleArea"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="-8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_handle" />

            <TextView
                android:id="@+id/panelToggleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nameGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/routeNameLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/route_name"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/routeNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/waypointCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sampleRouteButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/try_sample_route"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/loopSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/route_loop"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/timingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/route_use_gpx_timing"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetWalkButton"
                style="@style/Widget.GpsUpdater.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/speed_preset_walk"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetRunButton"
                style="@style/Widget.GpsUpdater.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/speed_preset_run"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetBikeButton"
                style="@style/Widget.GpsUpdater.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/speed_preset_bike"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetCarButton"
                style="@style/Widget.GpsUpdater.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/speed_preset_car"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:value="30"
            android:valueFrom="1"
            android:valueTo="160"
            android:stepSize="1"
            app:haloColor="@color/brand"
            app:thumbColor="@color/brand"
            app:trackColorActive="@color/brand" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/outageButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/naturalSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/natural_speed"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addWaypointButton"
                style="@style/Widget.GpsUpdater.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/add_waypoint"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/brand" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undoButton"
                style="@style/Widget.GpsUpdater.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:enabled="false"
                android:maxLines="1"
                android:text="@string/undo_waypoint"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_undo"
                app:iconTint="@color/brand" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveStartButton"
            style="@style/Widget.GpsUpdater.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/save_and_start_route"
            android:textAllCaps="false"
            app:backgroundTint="@color/brand"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/on_brand" />
    </LinearLayout>

</FrameLayout>
